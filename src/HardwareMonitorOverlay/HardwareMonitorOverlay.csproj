<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is pulled in only for NotifyIcon (tray menu); the UI itself is pure WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HardwareMonitorOverlay</AssemblyName>
    <RootNamespace>HardwareMonitorOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Keep the background footprint small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <!-- InvariantGlobalization must stay off: WPF's font cache constructs
         CultureInfo("en") during text layout and throws in invariant mode. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WFO0003 tells WinForms apps to declare DPI awareness in code instead of the
         manifest. This is a WPF app that only borrows WinForms for the tray icon, and
         WPF requires PerMonitorV2 to be declared in the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

</Project>
