<Window x:Class="HardwareMonitorOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Consolas, Cascadia Mono, Segoe UI"
        FontSize="{Binding FontSize}">

    <Window.Resources>
        <!-- Fixed column widths keep the digits from reflowing the panel as
             values change, so an update repaints text and nothing else. -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,1,10,1" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border CornerRadius="6"
            Background="#C0101014"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            Padding="10,6,10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CPU -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU"
                       Style="{StaticResource LabelText}"
                       Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuLoadText}"
                       Style="{StaticResource ValueText}" Foreground="#F0F0F0"
                       Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CpuTemperatureText}"
                       Style="{StaticResource ValueText}" MinWidth="58"
                       Foreground="{Binding CpuTemperatureBrush}"
                       Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}" />

            <!-- GPU -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU"
                       Style="{StaticResource LabelText}"
                       Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuLoadText}"
                       Style="{StaticResource ValueText}" Foreground="#F0F0F0"
                       Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GpuTemperatureText}"
                       Style="{StaticResource ValueText}" MinWidth="58"
                       Foreground="{Binding GpuTemperatureBrush}"
                       Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Border>
</Window>
